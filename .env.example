# Copy to .env and fill in. Never commit .env.
# Anthropic API key from https://platform.claude.com (a Claude Code / claude.ai
# subscription does NOT provide API access for this application).
ANTHROPIC_API_KEY=

# Model used for narrative analysis.
PITCH90_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max
PITCH90_EFFORT=high
# Server-side refusal fallback ("default" or "off"). Claude API only.
PITCH90_FALLBACKS=default
# Seconds before an API request is abandoned.
PITCH90_TIMEOUT_SECONDS=300
# Max slide/page images sent for visual interpretation per analysis.
PITCH90_MAX_VISUAL_PAGES=12

# Upload limits.
PITCH90_MAX_UPLOAD_MB=50
PITCH90_MAX_PAGES=150

# Default speaking rate for the pitch duration estimate (words per minute).
PITCH90_WORDS_PER_MINUTE=140

# Optional: full path to LibreOffice's soffice executable (for .ppt files and
# PPTX slide rendering). Auto-detected when unset.
PITCH90_SOFFICE_PATH=

# Optional: path to a custom analysis-report structure template
# (default: templates/analysis_report.md).
PITCH90_REPORT_TEMPLATE=

# --- Web deployment (Railway) ---
# Sign-in for the web app. Strongly recommended when deployed: without it anyone
# with the URL can run paid analyses on your API key.
APP_USERNAME=ten
APP_PASSWORD=
# Max simultaneous API analyses across all users (spend throttle).
PITCH90_MAX_CONCURRENT=2

# --- Result emails (Resend) ---
# Each analysis is emailed (summary + one-pager PDF + report PDF + JSON) when this is set.
RESEND_API_KEY=
# Comma-separated recipients.
REPORT_EMAIL_TO=Info@tencapital.group
# Sender: must be on a domain verified in Resend.
REPORT_EMAIL_FROM=TEN Capital Pitch Analysis <pitch90@tencapital.group>
# Also email demo-mode runs on the synthetic sample deck.
EMAIL_DEMO_RUNS=false
